APP_NAME=DentLegal
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dentlegal
DB_USERNAME=dentlegal
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Dashboard (Sanctum SPA cookie mode). Production: SESSION_DOMAIN=.<domain>, SESSION_SECURE_COOKIE=true,
# SANCTUM_STATEFUL_DOMAINS=portal.<domain>, DASHBOARD_URL=https://portal.<domain>. SESSION_LIFETIME is the 2 h idle timeout.
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
DASHBOARD_URL=http://localhost:3000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# DentLegal
DENTLEGAL_MIN_APP_VERSION=1.0.0
SMS_DRIVER=log
# App Store review number with a fixed code; leave empty outside review (PROJECT1_PLAN.md §8.9)
OTP_REVIEW_PHONE=
OTP_REVIEW_CODE=
AI_SERVICE_URL=http://ai-svc:8000
AI_SERVICE_TOKEN=
AI_SERVICE_TIMEOUT=30
# Case documents: 32 random bytes, base64 (php -r 'echo base64_encode(random_bytes(32));'). Keep a copy offline.
DOCUMENT_MASTER_KEY=

# Push (S5.5): log until the client's Firebase project exists; then fcm + the service-account JSON (never in git).
PUSH_DRIVER=log
FCM_CREDENTIALS=

# Behind Caddy (S9.3): the proxy network, so rate limits and HSTS see the real client. Empty = trust none.
TRUSTED_PROXIES=

# Daily AI health digest (§8.6): comma-separated emails; a flagged day also posts to the alert webhook
AI_HEALTH_RECIPIENTS=
AI_DAILY_COST_ALERT_USD=20
ALERT_WEBHOOK_URL=

# Error tracking (§8.6, D14): Sentry or GlitchTip DSN; empty = off
ERROR_TRACKING_DSN=
